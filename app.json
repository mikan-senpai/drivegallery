{
  "expo": {
    "name": "DriveGallery",
    "slug": "drive-gallery",
    "version": "0.1.0",
    "scheme": "drivegallery",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikansenpai.drivegallery"
    },
    "android": {
      "package": "com.mikansenpai.drivegallery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151413"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#151413"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7a676522-ce56-4583-a396-eb46ee646d0d"
      }
    },
    "owner": "mikanadhi"
  }
}
