{
  "expo": {
    "name": "DriveGallery",
    "slug": "drive-gallery",
    "version": "0.1.0",
    "scheme": "drivegallery",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.drivegallery"
    },
    "android": {
      "package": "com.example.drivegallery",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        { "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID" }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
